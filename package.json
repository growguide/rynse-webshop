{
  "name": "rynse-webshop",
  "version": "1.0.0",
  "private": true,
  "description": "RYNSE — premium DTC webshop (static front-end + Vercel Functions + Postgres + Mollie)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node tools/check-config.js && node src/web/build.js",
    "dev": "node src/server/dev.js",
    "start": "node src/server/dev.js",
    "db:migrate": "node tools/migrate.js",
    "db:reset": "node tools/migrate.js --reset",
    "config:check": "node tools/check-config.js --strict",
    "hero:frames": "node tools/hero-frames.js",
    "test": "node --test tests/",
    "test:e2e": "python3 tests/e2e/run.py"
  },
  "dependencies": {},
  "devDependencies": {}
}
