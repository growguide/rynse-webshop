# ---- Required ----------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/rynse?sslmode=require
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_TOKEN=change-me-random-token-for-the-admin-page
CRON_SECRET=change-me-random-token-vercel-cron-uses-this
SITE_URL=https://www.getrynse.example

# ---- Payments (Mollie) ---------------------------------------------------------
# emulator = local fake checkout (dev/test only). mollie = real Mollie API.
PAYMENT_PROVIDER=emulator
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MOLLIE_SEND_LINES=false        # send order lines to Mollie (strict VAT validation) — optional

# ---- E-mail --------------------------------------------------------------------
EMAIL_PROVIDER=log                 # log | resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="RYNSE <hello@getrynse.example>"

# ---- Commercial values (placeholders until final; see docs/CONFIGURATION.md) ----
# RYNSE_PRICE_CENTS=1500
# RYNSE_SHIPPING_CENTS=395
# RYNSE_FREE_SHIPPING_THRESHOLD_CENTS=3000
# RYNSE_SUBSCRIPTION_SHIPS_FREE=true
# RYNSE_SUBSCRIPTION_INTERVAL="1 month"
# RYNSE_SUBSCRIPTION_DISCOUNT_PCT=
# LOYALTY_YEAR_1_DISCOUNT=
# LOYALTY_YEAR_2_DISCOUNT=
# LOYALTY_YEAR_3_DISCOUNT=
# LOYALTY_YEAR_4_DISCOUNT=
# RYNSE_DELIVERY_ESTIMATE="1–3 working days"
# RYNSE_RETURN_WINDOW_DAYS=14
# RYNSE_PRICE_IS_FINAL=false       # true → publish price/availability in structured data
# RYNSE_LEGAL_NAME=
# RYNSE_LEGAL_ADDRESS=
# RYNSE_KVK=
# RYNSE_VAT=
# RYNSE_SUPPORT_EMAIL=

# ---- Analytics (loaded only after cookie consent) --------------------------------
# GA4_MEASUREMENT_ID=G-XXXXXXX
# GOOGLE_ADS_ID=AW-XXXXXXX
# META_PIXEL_ID=
# TIKTOK_PIXEL_ID=
